# Copy this file to .env for local development, then fill in the values.
# On your host (Render, Railway, etc.) add the same variables in the dashboard.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional overrides
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# PORT=8765
