# ─────────────────────────────────────────────
# Parashari Jyotish Software – environment template
# Copy this file to `.env` and adjust the values.
# ─────────────────────────────────────────────

# --- Application ---
APP_NAME="Parashari Jyotish Software API"
APP_VERSION=2.0.0
CALCULATION_VERSION=1.0.0
# Use staging/production only after configuring explicit CORS origins.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
RELOAD=false
DEBUG=false

# --- Database ---
# Leave empty to use a local SQLite file (backend/jyotish.db).
# The native desktop app ignores this key and always uses
# %LOCALAPPDATA%\ShivramJyotish\jyotish.db (see gui/paths.py).
# For production use e.g.: postgresql+psycopg2://user:pass@localhost:5432/jyotish
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed origins. Empty => local dev defaults.
# Example: https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# Limit applied to /calculate, /marriage-match, /prashna
CALCULATE_RATE_LIMIT=30/minute

# --- Nepali Patro (official panchang sync) ---
# Optional overrides. The service has a working public default and identifies
# itself honestly as ShivramJyotish/2.0.
NEPALI_PATRO_API_URL=https://api.nepalipatro.com.np/fetch/panchanga
# NEPALI_PATRO_API_KEY=
