# Copy this file to .env for local development, then fill in the values.
# On your host (Render, Railway, etc.) add the same variables in the dashboard.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Optional overrides
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4

# Fallback provider. When Cloudflare is out of quota or errors, the server
# automatically switches to Pollinations for both the prompt summary and picture.
POLLINATIONS_API=
# Optional Pollinations overrides
# POLLINATIONS_IMAGE_MODEL=flux
# POLLINATIONS_TEXT_MODEL=openai

# Nepali narration (TTS). Optional: without a key the server uses Microsoft
# Edge's free Nepali neural voice (ne-NP-HemkalaNeural), which needs no signup.
# Azure Speech is used first when configured.
# EDGE_TTS_VOICE=ne-NP-HemkalaNeural
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_TTS_VOICE=ne-NP-HemkalaNeural

# Local server port. Hosts like Render set PORT automatically.
PORT=8765
